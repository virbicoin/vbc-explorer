# nginx vhost example for the explorer behind Cloudflare.
#
# The application rate-limits by the single header named in TRUSTED_IP_HEADER
# (default X-Client-IP). nginx must set that header itself from Cloudflare's
# CF-Connecting-IP and overwrite X-Forwarded-For / X-Real-IP, so a client can
# never choose the IP the limits are keyed on. Direct hits that bypass
# Cloudflare carry no CF-Connecting-IP: the map below falls back to the TCP
# peer address ($remote_addr). Restricting 80/443 to Cloudflare's IP ranges
# with ufw is recommended as well.

# Real client IP: Cloudflare's header when present, otherwise the TCP peer.
map $http_cf_connecting_ip $explorer_client_ip {
    default $http_cf_connecting_ip;
    ""      $remote_addr;
}

# Second line of defence: nginx-level limit on the expensive endpoints,
# keyed by the real client IP (10 req/s, burst 20).
limit_req_zone $explorer_client_ip zone=explorer_api:10m rate=10r/s;

# Optional, more robust alternative: let the real_ip module rewrite
# $remote_addr from CF-Connecting-IP for Cloudflare's address ranges
# (https://www.cloudflare.com/ips/). Keep the list current.
# set_real_ip_from 173.245.48.0/20;
# set_real_ip_from 103.21.244.0/22;
# ...
# real_ip_header CF-Connecting-IP;

server {
    listen 443 ssl http2;
    server_name explorer.virbicoin.com explorer.digitalregion.jp;

    # ssl_certificate / ssl_certificate_key ...

    location /api/compile {
        limit_req zone=explorer_api burst=20 nodelay;
        include /etc/nginx/snippets/explorer-proxy.conf;
    }

    location /api/contract/verify {
        limit_req zone=explorer_api burst=20 nodelay;
        include /etc/nginx/snippets/explorer-proxy.conf;
    }

    location /api/tokens/ {
        limit_req zone=explorer_api burst=20 nodelay;
        include /etc/nginx/snippets/explorer-proxy.conf;
    }

    location / {
        include /etc/nginx/snippets/explorer-proxy.conf;
    }
}

# /etc/nginx/snippets/explorer-proxy.conf
# ---------------------------------------
# proxy_pass http://127.0.0.1:3000;
# proxy_http_version 1.1;
# proxy_set_header Host $host;
# proxy_set_header Upgrade $http_upgrade;
# proxy_set_header Connection "upgrade";
#
# # The only header the application trusts for the client IP. Always set,
# # never passed through from the client.
# proxy_set_header X-Client-IP $explorer_client_ip;
#
# # Overwrite (do not append to) the client-supplied values.
# proxy_set_header X-Forwarded-For $remote_addr;
# proxy_set_header X-Real-IP $remote_addr;
# proxy_set_header X-Forwarded-Proto $scheme;
