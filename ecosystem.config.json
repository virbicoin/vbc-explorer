{
  "apps": [
    {
      "name": "explorer",
      "script": "npm",
      "args": "start",
      "cwd": ".",
      "env": {
        "NODE_ENV": "production",
        "NODE_OPTIONS": "--max-old-space-size=512",
        "MEMORY_LIMIT_MB": "512"
      },
      "max_memory_restart": "1024M",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "max_restarts": 10,
      "min_uptime": "30s",
      "restart_delay": 10000,
      "log_file": "./logs/web.log",
      "out_file": "./logs/web-out.log",
      "error_file": "./logs/web-error.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    }
  ]
}
