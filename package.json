{
  "name": "vbc-explorer",
  "version": "0.8.10",
  "description": "A modern blockchain explorer for VirBiCoin network with NFT support, contract verification, and real-time statistics",
  "keywords": [
    "blockchain",
    "explorer",
    "virbicoin",
    "cryptocurrency",
    "nft",
    "smart-contracts",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/virbicoin/vbc-explorer.git"
  },
  "license": "MIT",
  "author": "Aoi Emerauda",
  "contributors": [
    "Elaine",
    "Cody",
    "Hackmod",
    "Bakon"
  ],
  "homepage": "https://explorer.virbicoin.com",
  "bugs": {
    "url": "https://github.com/virbicoin/vbc-explorer/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "worker": "tsx tools/worker.ts",
    "sync": "tsx tools/sync.ts",
    "tokens": "tsx tools/tokens.ts",
    "richlist": "tsx tools/richlist.ts",
    "price": "tsx tools/price.ts",
    "internal-txs": "tsx tools/internal-txs.ts",
    "optimize-indexes": "tsx tools/optimize-indexes.ts",
    "repair-chain": "tsx tools/repair-chain.ts",
    "flag-spam-tokens": "tsx tools/flag-spam-tokens.ts",
    "backfill-uncle-rewards": "tsx tools/backfill-uncle-rewards.ts",
    "backfill-verification-settings": "tsx tools/backfill-verification-settings.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.105.0",
    "ethers": "^6.17.0",
    "lightweight-charts": "^5.2.1",
    "mongoose": "^9.11.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "solc": "^0.8.38",
    "viem": "^2.57.12",
    "wagmi": "^3.7.9",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "solc": {
      "tmp": "^0.2.7"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.12"
    }
  }
}
