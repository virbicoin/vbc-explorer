# VBC Explorer Environment Variables
# Copy this file to .env (or .env.local, which takes precedence) and fill in
# your values. Next.js and the CLI tools (tools/*.ts, via lib/env.ts) read the
# same files from the project root; variables already set in the environment
# win. DO NOT commit .env or .env.local to version control, and do not put
# credentials in ecosystem.config.json or pm2's environment.

# ===========================================
# Required Configuration
# ===========================================

# MongoDB Connection URI (required: there is no default, the tools stop without it)
# Format: mongodb://user:password@host:port/database?authSource=authDB
# Percent-encode reserved characters in the password (e.g. @ -> %40, : -> %3A)
MONGODB_URI=mongodb://explorer:your_secure_password@localhost:27017/explorerDB?authSource=explorerDB

# ===========================================
# Optional Configuration
# ===========================================

# Web3 Provider URL (overrides config.json)
# WEB3_PROVIDER_URL=http://localhost:8545

# Node Environment
NODE_ENV=development

# ===========================================
# API Keys (Optional)
# ===========================================

# CoinGecko API Key (for higher rate limits)
# COINGECKO_API_KEY=your_api_key

# ===========================================
# Security Settings (Production)
# ===========================================

# Header that carries the real client IP for rate limiting. nginx must set it
# from Cloudflare's CF-Connecting-IP and discard the client-supplied value
# (see docs/nginx-explorer.conf.example). X-Forwarded-For is never trusted.
# TRUSTED_IP_HEADER=x-client-ip

# Session Secret (for future auth features)
# SESSION_SECRET=your_random_secret_here

# ===========================================
# Deployment Settings
# ===========================================

# Port (Next.js default is 3000)
# PORT=3000

# Base URL for production
# NEXT_PUBLIC_BASE_URL=https://explorer.example.com
